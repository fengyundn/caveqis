FROM python:3.14.10-slim-bookworm@sha256:3fe1a0b6c2d6b2ebb572906cdabeca75aeb558c0c17db5ffefbcf8094871c32b AS python-runtime
FROM node:24-bookworm AS toolchain
ENV DEBIAN_FRONTEND=noninteractive
RUN sed -i 's@http://deb.debian.org@https://deb.debian.org@g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
    fakeroot xz-utils zstd \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
COPY --from=python-runtime /usr/local/ /usr/local/

FROM toolchain AS builder
COPY . .
RUN --mount=type=cache,target=/root/.cache/pip \
    --mount=type=cache,target=/root/.npm \
    --mount=type=cache,target=/root/.cache/electron \
    --mount=type=cache,target=/root/.cache/electron-builder \
    bash desktop/build-linux.sh

FROM scratch AS release
COPY --from=builder /work/desktop/dist/*.deb /
